# ==============================================================================
# EXPORT Automation System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust settings to match your environment.
# Note: By default, the system runs safely in offline simulation mode (TEST_MODE=True).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PIPELINE & SAFETY CONTROLS
# ------------------------------------------------------------------------------
# TEST_MODE: When True, uses mock search adapters, mock AI fallback (if key missing),
# and simulates all outreach dispatches with zero external network costs.
# Set to False when deploying for live lead discovery and real outreach.
TEST_MODE=True

# DRY_RUN: When True, outreach builds and validates all MIME emails and catalog PDFs
# but does NOT dispatch them through live SMTP sockets.
# Set to False only when you are ready to send genuine commercial emails.
DRY_RUN=True

# ------------------------------------------------------------------------------
# 2. TARGET MARKET & LEAD DISCOVERY (Phase 2)
# ------------------------------------------------------------------------------
# Primary query used by search adapters (Google, B2B directories, website crawlers)
SEARCH_KEYWORD=Singing Bowls wholesale imports studio

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI LEAD QUALIFICATION (Phase 3)
# ------------------------------------------------------------------------------
# Optional: Google Gemini API Key for intelligent buyer qualification and tiering.
# Get a key from: https://aistudio.google.com/app/apikey
# If left blank, the system automatically uses explainable rule-based heuristics.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. B2B EMAIL OUTREACH & SMTP (Phase 4)
# ------------------------------------------------------------------------------
# Gmail address used for authenticating with the SMTP server
GMAIL_EMAIL=

# Google App Password (16 characters, no spaces).
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_APP_PASSWORD=

# SMTP Server Host and Port
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# USE_SSL: True for Port 465 (SSL/TLS direct). False for Port 587 (STARTTLS).
USE_SSL=True

# Maximum number of outreach emails allowed per 24-hour rolling window
DAILY_SEND_LIMIT=100

# ------------------------------------------------------------------------------
# 5. PRODUCT CATALOG ATTACHMENT & SENDER IDENTITY (Phase 4)
# ------------------------------------------------------------------------------
# Relative or absolute path to the company PDF export catalog attachment
PRESENTATION_PATH=assets/company_presentation.pdf

# Commercial representative and brand details inserted into email signatures
SENDER_NAME=Himalayan Export & Artisan Guild
SENDER_COMPANY=Himalayan Artisan Singing Bowls Ltd.
SENDER_CONTACT=+977-1-4412345 | export@himalayanartisanbowls.com
